int Procesador::procesar(){
        std::queue<int> copia = entrada;
        std::stack<int> pilaPar;
        while(!copia.empty()){
            int v = copia.front();
            if(v%2 == 0){
                pilaPar.push(v);
                }
            copia.pop();
            }
        if(pilaPar.empty()) return 0;
        
        Node* head = nullptr;
        Node* actual = nullptr;
        int cont = 0;
        
        while(!pilaPar.empty()){
            int valor = pilaPar.top();
            pilaPar.pop();
            cont++;
            Node* nuevo = new Node(valor);
            if(head == nullptr){
                head = nuevo;
                actual = head;
                }
            else{
                actual->next = nuevo;
                actual = nuevo;
                }    
            
            }
            
        Node* temp = head;
        while(temp != nullptr){
            Node* borrar = temp;
            temp = temp->next;
            delete borrar;
            }
    return cont;
